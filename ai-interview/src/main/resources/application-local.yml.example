# 复制为 application-local.yml 后填写真实值
# IDEA：Active profiles = local

aliyun:
  dashscope:
    apiKey: sk-xxxxxxxx
  dashvector:
    enabled: true
    apiKey: 你的_DashVector_API_Key
    endpoint: vrs-cn-xxxxx.dashvector.cn-hangzhou.aliyuncs.com
    collection: interview_rag
    dimension: 1024
    topK: 5
    # 与 Collection 中稠密向量字段名一致（不要用 proxima_vector）
    vectorField: embedding
